<?xml version="1.0"?>
<!-- Gazebo half of the demo: vineyard block + the wheeled harvesting platform. -->
<launch>

  <arg name="gui"    default="true"/>
  <arg name="paused" default="false"/>
  <!-- torque:=true drives the joints by torque through a PID instead of
       writing angles into the physics engine. See
       config/gazebo_controllers_torque.yaml for what works and what is
       still being tuned. -->
  <arg name="torque" default="false"/>
  <!-- $(eval) has to be a whole attribute, so the two things that vary
       with it are computed into their own args and referenced below. -->
  <arg name="joint_hw"
       default="$(eval 'Effort' if arg('torque') else 'Position')"/>
  <arg name="ctrl_yaml"
       default="$(eval 'gazebo_controllers_torque' if arg('torque') else 'gazebo_controllers')"/>

  <!-- Spawn pose: on the working lane of row 0, which make_models.lane_x(0)
       puts at x = 1.20, i.e. 0.80 m off the row, NOT the aisle centre. Rows are
       2.2-3.0 m apart, so an aisle centre is 1.1-1.5 m from the vine, too
       far out for the arm to reach fruit hanging at 1.4-1.7 m. The robot
       starts south of the block, inside the polytunnel, facing +y. -->
  <arg name="x"   default="1.20"/>
  <arg name="y"   default="-5.20"/>
  <arg name="z"   default="0.06"/>
  <arg name="yaw" default="1.5708"/>

  <env name="GAZEBO_MODEL_PATH"
       value="$(find grape_harvest)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(find grape_harvest)/worlds/vineyard.world"/>
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
    <arg name="verbose"      value="true"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro $(find grape_harvest)/urdf/cr10_grape.xacro
                  joint_hw:=$(arg joint_hw)"/>

  <!-- Spawned with the arm already near the stow pose so it does not flail
       through the trellis while the controllers come up. -->
  <node name="spawn_robot" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -param robot_description -model cr10_robot
              -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)
              -J joint1 0 -J joint2 -0.9 -J joint3 2.4
              -J joint4 -3.0708 -J joint5 -1.5708 -J joint6 0
              -unpause"/>

  <rosparam command="load"
            file="$(find grape_harvest)/config/$(arg ctrl_yaml).yaml"/>

  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen"
        args="joint_state_controller arm_controller"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>


  <!-- world -> odom correction. Stands in for VINS-Mono; see world_tf.py. -->
  <node name="world_tf" pkg="grape_harvest" type="world_tf.py" output="screen"/>

</launch>
